# ============================================================
# TRADING BOT - API KEYS CONFIGURATION
# Copy this file to .env and fill in your real keys.
# NEVER commit your .env file to git.
# ============================================================

# ============================================================
# BROKER APIs
# ============================================================

# --- Alpaca (US Stock Paper Trading) ---
# Sign up FREE at https://alpaca.markets → click "Paper Trading"
# Navigate to: Overview → API Keys → Generate New Key
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- Binance (Crypto Testnet) ---
# Register at https://testnet.binance.vision (separate from real Binance)
# Generate API keys there for free paper trading
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_SECRET_KEY=your_binance_testnet_secret_key_here
BINANCE_TESTNET=true

# ============================================================
# DATA SOURCE APIs
# ============================================================

# --- NewsAPI (Financial News) ---
# Free tier: 100 requests/day — sign up at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# --- Reddit API ---
# Free — create an app at https://www.reddit.com/prefs/apps
# Choose "script" type. Client ID is the short string under your app name.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=TradingBot/1.0 by YourRedditUsername

# --- Twitter / X API ---
# Sign up at https://developer.twitter.com → Create Project → Get Bearer Token
# Basic tier ($100/mo) required for search. Free tier is write-only.
# Leave blank to skip Twitter data — the bot will still run on news + Reddit.
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================================
# NOTIFICATIONS
# ============================================================

# --- Discord Webhook ---
# In Discord: Server Settings → Integrations → Webhooks → New Webhook
# Copy the Webhook URL and paste it below.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================================
# BOT SETTINGS (optional overrides)
# ============================================================

# Set to "true" to enable FinBERT (better sentiment accuracy, needs ~2GB RAM)
# Requires: pip install transformers torch
# Default: false (uses VADER — fast, lightweight)
USE_FINBERT=false

# Dry run: log signals but execute NO real/paper trades
DRY_RUN=false
